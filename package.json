{
  "name": "omra-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-precache.mjs",
    "start": "node scripts/serve-static.mjs",
